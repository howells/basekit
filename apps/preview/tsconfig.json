{
  "extends": "@howells/typescript-config/nextjs",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["react", "react-dom"],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
